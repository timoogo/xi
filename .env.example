BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_PATH=./data/xi-auth.sqlite

# Absolute path of the existing Obsidian vault (server only, never sent to the browser).
XI_VAULT_PATH=/absolute/path/to/obsidian/vault

# Local LLM (docs/llm.md). Instances are normally configured per account in
# Paramètres → Intelligence artificielle; these optional variables define the
# installation's server, used by owners who chose no default instance.
XI_INFERENCE_URL=
XI_INFERENCE_API=
XI_INFERENCE_MODEL=
XI_INFERENCE_TIMEOUT_MS=
# Extra public IP addresses allowed for LLM servers (local networks are allowed by default).
XI_INFERENCE_ALLOW=
# Optional restriction of LLM destinations to these hosts ("host" or "host:port", comma-separated).
XI_LLM_ALLOWED_HOSTS=
